<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- A camp's tent pin on the world map (CampMap.lua). -->
	<Frame name="CampingKitMapPinTemplate" mixin="CampingKitMapPinMixin" virtual="true" enableMouse="true">
		<Size x="22" y="22"/>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- Glows while the camp is looking for something you can place. -->
				<Texture parentKey="Glow" file="Interface\AddOns\CampingKit\media\glow_ring" alphaMode="ADD" hidden="true">
					<Size x="40" y="40"/>
					<Anchors><Anchor point="CENTER"/></Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Icon" file="Interface\AddOns\CampingKit\media\tent_closed_32">
					<Anchors><Anchor point="TOPLEFT"/><Anchor point="BOTTOMRIGHT"/></Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="1">
				<!-- Instead of the tent while the camp's exact spot isn't known. -->
				<Texture parentKey="Area" file="Interface\AddOns\CampingKit\media\ring_dashed_64" hidden="true">
					<Size x="34" y="34"/>
					<Anchors><Anchor point="CENTER"/></Anchors>
					<Color r="1" g="0.7" b="0.25"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="2">
				<!-- What it's looking for that you can place. -->
				<Texture parentKey="Badge" hidden="true">
					<Size x="12" y="12"/>
					<Anchors><Anchor point="CENTER" relativePoint="BOTTOMRIGHT" x="-2" y="2"/></Anchors>
				</Texture>
			</Layer>
		</Layers>
		<!-- No Scripts: the map canvas calls the mixin's OnLoad itself and wires
		     OnMouseEnter/OnMouseLeave; an OnEnter/OnLeave here trips its assert. -->
	</Frame>
</Ui>
